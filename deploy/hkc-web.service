# Шаблон: установщик заменяет __HKC_SOURCE_DIR__ и __HKC_SERVICE_USER__.
[Unit]
Description=Веб-панель Heroku
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__HKC_SERVICE_USER__
# Закрытый файл окружения задаёт пути и административный секрет.
EnvironmentFile=/etc/hkc/hkc.env
WorkingDirectory=__HKC_SOURCE_DIR__
ExecStart=__HKC_SOURCE_DIR__/bin/hkc-web
Restart=always
RestartSec=2
# Остановка и перезапуск завершают только панель: бот — её дочерний процесс, но работает
# дальше, и новая панель находит его по /proc. Остановить бота — кнопкой в панели.
KillMode=process
UMask=0077
# Защитные ограничения службы, а не отдельная песочница для команд терминала.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
